# The Carry Tavern — bot environment variables
# Copy this file to .env on the bot host and fill in the blank values.
# NEVER commit real tokens, Discord secrets or Supabase secret keys to GitHub.

# Discord bot
TOKEN=
CLIENT_ID=
GUILD_ID=
# Legacy/generic Carrier role. Also used as the Barback fallback.
CARRIER_ROLE=
# Discord role required to claim Carry Tickets.
# Defaults to this role ID in code if the variable is omitted.
CARRY_CLAIM_ROLE_ID=1538643501737058404

# Optional automatic Carrier rank role sync.
# Set these to the Discord role IDs for each website Carrier rank.
# The bot role must sit above every role it needs to assign/remove.
CARRIER_ROLE_BARBACK=
CARRIER_ROLE_BARTENDER=
CARRIER_ROLE_CASKKEEPER=
CARRIER_ROLE_TAPMASTER=
CARRIER_ROLE_BREWMASTER=
CARRIER_ROLE_MASTER_OF_TAP=

# Optional Discord -> website staff permission sync.
# Members with these Discord roles receive the matching website platform role.
PLATFORM_DISCORD_ROLE_TREASURY=
PLATFORM_DISCORD_ROLE_MODERATOR=
PLATFORM_DISCORD_ROLE_ADMINISTRATOR=

# Carry tickets / onboarding / Roblox verification.
# Private carry tickets are created under this category. If blank, the bot uses the queue channel's category.
TICKET_CATEGORY_ID=
# New members are pointed here for Roblox verification instructions.
VERIFICATION_CHANNEL_ID=
# Published Roblox Place ID for the Carry Tavern verification game.
# /roblox link sends members directly to https://www.roblox.com/games/<this id>
ROBLOX_VERIFICATION_PLACE_ID=
# Optional rules channel shown by /onboarding guide.
RULES_CHANNEL_ID=
# Optional roles. New members receive UNVERIFIED_ROLE_ID until Roblox verification succeeds.
UNVERIFIED_ROLE_ID=
VERIFIED_ROLE_ID=

# Optional staff-only log channel used for warnings, no-shows, disputes and anti-abuse flags.
MOD_LOG_CHANNEL_ID=

# Optional Discord channels for automatic website/platform announcements.
# Leave blank to disable that announcement type.
CARRY_QUEUE_CHANNEL_ID=
MARKETPLACE_CHANNEL_ID=
# Channel that holds the permanent interactive Treasury Stock panel.
# Users choose Legendaries or Collects; Collects then gives a colour selector.
TREASURY_STOCK_CHANNEL_ID=

# Discord -> website content feeds.
# EVENT_FEED_CHANNEL_ID is the normal Event channel. Human messages are mirrored with author name/avatar.
EVENT_FEED_CHANNEL_ID=
# ANNOUNCEMENT_CHANNEL_ID is the separate important-announcements channel. Human messages are mirrored separately.
ANNOUNCEMENT_CHANNEL_ID=

# Optional website notification -> Discord DM delivery.
DM_NOTIFICATIONS_ENABLED=false

# Carry Tavern Marketplace / Supabase
SUPABASE_URL=https://ylqdfiuflvublqzrxoyj.supabase.co
# Server-only key from Supabase: Settings -> API Keys -> Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# Public website base URL, without a trailing slash
MARKETPLACE_URL=https://carry-tavern.davidtennyson846.workers.dev

# OpenAI / AI server manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AI_MANAGER_ROLE_ID=
AI_AUDIT_CHANNEL_ID=
AI_MAX_TOOL_ROUNDS=3

# PROJECT SENTIENT — live Discord character layer
# Official Discord application token for [ERR_] Th3_B4rt3nd3r.
SENTIENT_BARTENDER_TOKEN=
SENTIENT_BARTENDER_NAME=[ERR_] Th3_B4rt3nd3r

# Optional official second bot account for ERR_02.
# If omitted, ERR_02 uses the Sentient Relay webhook fallback.
SENTIENT_ERR02_TOKEN=
SENTIENT_ERR02_NAME=[ERR_02]
SENTIENT_ERR02_AVATAR_URL=

# Optional official third bot account for TAVERN CORE.
# If omitted, TAVERN CORE uses the Sentient Relay webhook fallback.
SENTIENT_CORE_TOKEN=
SENTIENT_CORE_NAME=TAVERN CORE
SENTIENT_CORE_AVATAR_URL=

# Hidden owner IDs allowed to use !sentientlive controls, comma-separated.
# The Discord guild owner is always accepted too.
SENTIENT_OWNER_IDS=

# Channels where Bartender is allowed to read PUBLIC conversation and reply, comma-separated.
# If omitted, SENTIENT_TAVERN_CHAT_CHANNEL_ID is used as the single fallback.
SENTIENT_AI_CHANNEL_IDS=
SENTIENT_TAVERN_CHAT_CHANNEL_ID=

# Optional channel where the ONE-TIME ERR_02 `hello?` should fire.
# If blank, it fires in the channel where the owner runs the command.
SENTIENT_ERR02_CHANNEL_ID=

# Channel used later for the three-entity main-event binary/English burst.
# If blank, Tavern chat is used.
SENTIENT_CHAOS_CHANNEL_ID=

# Default live state after restart. Safer to leave false and use !sentientlive on when ready.
SENTIENT_LIVE_AI_ENABLED=false

# Bartender behavior tuning.
# Direct replies are much more likely than spontaneous interruptions.
SENTIENT_SPONTANEOUS_CHANCE=0.12
SENTIENT_DIRECT_GLOBAL_COOLDOWN_MS=15000
SENTIENT_DIRECT_USER_COOLDOWN_MS=45000
SENTIENT_SPONTANEOUS_GLOBAL_COOLDOWN_MS=90000

# Identity/privacy rule is hard-coded: use server nickname only; if none exists, Discord username.
# The live character layer does NOT read or infer legal names, global profile names,
# emails, OAuth identity hints or website identity data.
