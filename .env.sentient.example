# Native Project SENTIENT integration for The Carry Tavern bot.
# Copy these values into the bot host's existing .env. Never commit real secrets.

# Master switch. If disabled or unconfigured, the ordinary Tavern bot keeps working.
SENTIENT_INTEGRATION_ENABLED=true

# The existing private sentient-control service. Keep loopback when both run on the same OCI VM.
SENTIENT_CONTROL_BASE_URL=http://127.0.0.1:3000
# Must match SENTIENT_ADMIN_SECRET on the sentient-control host.
SENTIENT_ADMIN_SECRET=
SENTIENT_CONTROL_TIMEOUT_MS=12000

# Privacy-first Discord perception. Message content is OFF by default; sampled metadata still feeds operations.
SENTIENT_CAPTURE_MESSAGE_CONTENT=false
SENTIENT_MESSAGE_EVENT_SAMPLE_EVERY=25
SENTIENT_MEMBER_EVENTS_ENABLED=true
SENTIENT_STRUCTURE_EVENTS_ENABLED=true
SENTIENT_INGEST_INTERACTIONS=true

# Operational state / snapshots.
SENTIENT_SNAPSHOT_ON_READY=true
SENTIENT_HEARTBEAT_MS=300000
SENTIENT_EVENT_QUEUE_LIMIT=500

# Never auto-create SENTIENT Discord structure unless deliberately armed.
# Staff can run /sentient setup manually; the backend bootstrap is create-only.
SENTIENT_AUTO_BOOTSTRAP=false
SENTIENT_DEFAULT_GUILD_MODE=full
