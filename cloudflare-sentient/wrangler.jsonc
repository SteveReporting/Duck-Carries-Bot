{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carry-tavern-sentient",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "carry-tavern-sentient",
      "binding": "SENTIENT_WORKFLOW",
      "class_name": "SentientWorkflow"
    }
  ]
}
