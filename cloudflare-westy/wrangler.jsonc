{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "westy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "WESTY_APPLICATION_ID": "1545579363754451005",
    "WESTY_NAME": "Westy"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WESTY_GATEWAY",
        "class_name": "WestyGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "westy-gateway-v1",
      "new_sqlite_classes": ["WestyGateway"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
